    "keywords": ["XML", "XMLReader", "Iterator", "SimpleXML"],
    "homepage": "https://github.com/mrLexx/SimpleXMLReader",
    "type": "library",
    "authors": [
        {
            "name": "mrLexx",
            "homepage": "https://github.com/mrLexx/"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "mrLexx\\": "src/"
        }
    },
    "license": "PDDL-1.0",
    "require": {
        "php": "^7.4 || ^8.0",
        "lib-libxml" : "*",
        "ext-xmlreader" : "*",
        "ext-dom" : "*",
        "ext-simplexml": "*"
    }
}
